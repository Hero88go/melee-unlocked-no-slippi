+/* Envelope snapshot state: each joint once (native_pose_joints), chains as index lists. */
+static HSD_JObj* native_env_joint_objs[MU_NATIVE_POSE_MAX_TOTAL_JOINTS];
+static HSD_JObj* native_env_chain_leaves[MU_NATIVE_POSE_MAX_CHAINS];
