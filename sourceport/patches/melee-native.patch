+#define ENQUEUE_INFO(queue, info, link)                                       \
+    do {                                                                      \
+        OSModuleInfo* __prev;                                                 \
+                                                                              \
+        __prev = (queue)->tail;                                               \
+        if (__prev == NULL)                                                   \
+            (queue)->head = (info);                                           \
+        else                                                                  \
+            __prev->link.next = (info);                                       \
+        (info)->link.prev = __prev;                                           \
+        (info)->link.next = NULL;                                             \
+        (queue)->tail = (info);                                               \
+    } while (0)
+
+#define DEQUEUE_INFO(info, queue, link)                                       \
+    do {                                                                      \
+        OSModuleInfo* __next;                                                 \
+        OSModuleInfo* __prev;                                                 \
+                                                                              \
+        __next = (info)->link.next;                                           \
+        __prev = (info)->link.prev;                                           \
+                                                                              \
+        if (__next == NULL)                                                   \
+            (queue)->tail = __prev;                                           \
+        else                                                                  \
+            __next->link.prev = __prev;                                       \
+                                                                              \
+        if (__prev == NULL)                                                   \
+            (queue)->head = __next;                                           \
+        else                                                                  \
+            __prev->link.next = __next;                                       \
+    } while (0)
