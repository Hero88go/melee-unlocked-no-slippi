+#ifdef MU_NATIVE
+/* The console decoder is paired-single and bit-reader assembly over a work struct with 32-bit
+ * pointers at fixed offsets. This is the same baseline decode in C: same markers, scan read MSB
+ * first with no byte stuffing (a restart only byte-aligns), same AAN float IDCT, output in the same
+ * I8 tile order. Its state lives in the work area sized by THPDec_8032FD40. */
+typedef struct MuTHPHuff {
+    s32 maxCode[18];
+    s32 valPtr[17];
+    u8 vals[256];
+} MuTHPHuff;
+
+typedef struct MuTHPDecoder {
+    const u8* file;
+    u32 bitBuf;
+    s32 bitCnt;
+    u16 xSize;
+    u16 ySize;
+    u16 xPixelSize;
+    u16 yPixelSize;
+    u16 nMCU;
+    u16 currMCU;
+    u8 RST;
+    u8 quantSel[3];
+    u8 dcSel[3];
+    u8 acSel[3];
+    s16 predDC[3];
+    MuTHPHuff huff[4];
+    f32 quant[4][64];
+} MuTHPDecoder;
+
+static inline u32 mu_thp_bit(MuTHPDecoder* d)
+{
+    if (d->bitCnt == 0) {
+        d->bitBuf = *d->file++;
+        d->bitCnt = 8;
+    }
+    d->bitCnt--;
+    return (d->bitBuf >> d->bitCnt) & 1;
+}
+
+static inline u32 mu_thp_bits(MuTHPDecoder* d, s32 n)
+{
+    u32 v = 0;
+    while (n-- > 0) {
+        v = (v << 1) | mu_thp_bit(d);
+    }
+    return v;
+}
+
+static inline s32 mu_thp_extend(u32 v, s32 s)
+{
+    return (v < (1u << (s - 1))) ? (s32) v - (1 << s) + 1 : (s32) v;
+}
+
+static s32 mu_thp_huff(MuTHPDecoder* d, const MuTHPHuff* h)
+{
+    s32 code = 0;
+    s32 l;
+
+    for (l = 1; l <= 16; l++) {
+        code = (code << 1) | (s32) mu_thp_bit(d);
+        if (code <= h->maxCode[l]) {
+            return h->vals[(code + h->valPtr[l]) & 0xFF];
+        }
+    }
+    return 0;
+}
+
+static void mu_thp_build_huff(MuTHPHuff* h, const u8* bits, const u8* vals)
+{
+    s32 code = 0;
+    s32 p = 0;
+    s32 l;
+    s32 i;
+
+    for (l = 1; l <= 16; l++) {
+        if (bits[l - 1]) {
+            h->valPtr[l] = p - code;
+            for (i = 0; i < bits[l - 1]; i++, p++) {
+                h->vals[p & 0xFF] = vals[p];
+            }
+            code += bits[l - 1];
+            h->maxCode[l] = code - 1;
+        } else {
+            h->maxCode[l] = -1;
+            h->valPtr[l] = 0;
+        }
+        code <<= 1;
+    }
+    h->maxCode[17] = 0xFFFFF;
+}
+
+static void mu_thp_block(MuTHPDecoder* d, THPCoeff* blk, s32 c)
+{
+    s32 t;
+    s32 k;
+    s32 r;
+    s32 s;
+
+    __builtin_memset(blk, 0, 64 * sizeof(THPCoeff));
+    t = mu_thp_huff(d, &d->huff[(d->dcSel[c] << 1) & 3]);
+    d->predDC[c] += t ? mu_thp_extend(mu_thp_bits(d, t), t) : 0;
+    blk[0] = d->predDC[c];
+
+    for (k = 1; k < 64; k++) {
+        t = mu_thp_huff(d, &d->huff[((d->acSel[c] << 1) + 1) & 3]);
+        r = t >> 4;
+        s = t & 15;
+        if (s != 0) {
+            k += r;
+            if (k > 63) {
+                break;
+            }
+            blk[__THPJpegNaturalOrder[k]] = mu_thp_extend(mu_thp_bits(d, s), s);
+        } else {
+            if (r != 15) {
+                break;
+            }
+            k += 15;
+        }
+    }
+}
