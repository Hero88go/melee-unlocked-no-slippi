+/* `object` names the joint the scope draws and `piece` the PObj itself (both 0 at the end): the
+ * host pairs each draw with the same PObj's draw in the next frame, whatever else came or went. */
+static void PObjEmitNativeScopeEvent(u32 phase, u32 scope_id, u32 object, u32 piece)
+{
+    u32 sequence = ++native_render_event_sequence;
+    mu_native_render_scope_event(sequence, scope_id, phase);
+
+    /* 0xF0 is a private MU_NATIVE diagnostic token consumed by the host GX decoder. */
+    GXW_u8(0xF0);
+    GXW_u32(sequence);
+    GXW_u32(scope_id);
+    GXW_u32(phase);
+    GXW_u32(object);
+    GXW_u32(piece);
+}
