+/* ---- the sound banks an m-ex disc adds (akaneia plan step 8) ---- */
+
+/* At each content view change (akaneia/mu_ak_fighters.c): in the mod view the rows past the
+ * retail banks take the disc's own bank table (file, sample bytes, group and priorities). The
+ * retail rows keep their retail values. The count is never lowered again, so a bank loaded in
+ * the mod view is still unloaded by the ordinary loader after a view change. */
+void mu_ak_sound_view(int mod_view)
+{
+    int count, i, filled = 0;
+    if (!mod_view) {
+        return;
+    }
+    count = mu_mex_ssm_count();
+    if (count > LB_SSM_CAP - 1) {
+        OSReport("[ak] sound: the disc has %d sound banks, room for %d; the rest are not loaded\n",
+                 count, LB_SSM_CAP - 1);
+        count = LB_SSM_CAP - 1;
+    }
+    for (i = 56; i < count; i++) {
+        const char* file = NULL;
+        unsigned int size = 0;
+        signed char row[4] = { 0, 0, 0, 0 };
+        if (!mu_mex_ssm_bank(i, &file, &size, row)) {
+            ssm_files[i] = NULL;
+            continue;
+        }
+        if (i >= lb_ssm_n) {
+            /* A row the loader has not seen yet: nothing requested, nothing loaded. */
+            lbl_804337C4[i] = -1;
+            lbl_804338A4[i] = -1;
+            lbl_80433984[i] = -1;
+            lbl_80433A64[i] = -1;
+        }
+        ssm_files[i] = file;
+        offsets_arr_803BC4E4[i][0] = size;
+        offsets_arr_803BC4E4[i][1] = 0;
+        s32_arr_803BB5D0[i][0] = row[0];
+        s32_arr_803BB5D0[i][1] = row[1];
+        s32_arr_803BB5D0[i][2] = row[2];
+        s32_arr_803BB5D0[i][3] = row[3];
+        filled++;
+    }
+    if (count > lb_ssm_n) {
+        lb_ssm_n = count;
+    }
+    OSReport("[ak] sound: %d banks on this disc, %d added rows filled\n", count, filled);
+}
