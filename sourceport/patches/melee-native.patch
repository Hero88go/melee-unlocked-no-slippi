-                            }
-                            ASSERTLINE(0x20C, MINOBJSIZE <= (char*) start - (char*) cell);
-                            hd->size -= ((char*)cellEnd - (char*)start);
-                            cell->size = ((char*)start - (char*)cell);
-                        } else {
