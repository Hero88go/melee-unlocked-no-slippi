+/* Once a frame on the character select screen: L / R change the port's shield color, D-pad up /
+ * down turn its rumble on / off (with a short rumble when it turns on). */
+static void mu_te_css_frame(void)
+{
+    int port;
+    if (!mu_te_general()) {
+        return;
+    }
+    for (port = 0; port < 4; port++) {
+        const u32 pressed = HSD_PadCopyStatus[port].trigger;
+        if (pressed & (HSD_PAD_DPADUP | HSD_PAD_DPADDOWN)) {
+            const bool on = (pressed & HSD_PAD_DPADUP) != 0;
+            gmMainLib_SetRumbleEnabled(port, on);
+            if (on) {
+                lb_80014574((u8) port, 0, 0xB, 0x1E);   /* the same short rumble the screen gives a new player */
+            }
+            lbAudioAx_80024030(1);
+        }
+        if (mu_te2(MU_TE2_SHIELD_COLORS) && mu_te_shield_text[port] != NULL &&
+            (pressed & (HSD_PAD_L | HSD_PAD_R)))
+        {
+            mu_te_shield_cycle(port, (pressed & HSD_PAD_R) ? 1 : -1);
+            mu_te_shield_label(port);
+            lbAudioAx_80024030(2);
+        }
+    }
+}
