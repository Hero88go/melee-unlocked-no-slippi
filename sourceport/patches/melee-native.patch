-            dst[i * 4 + 1] = colorIndex[src[i] >> 4 & 3];
-            dst[i * 4 + 2] = colorIndex[src[i] >> 2 & 3];
-            dst[i * 4 + 3] = colorIndex[src[i] >> 0 & 3];
-        }
-    }
