+            d->xPixelSize = (p[5] << 8) | p[6];
+            for (i = 0; i < 3 && i < p[7]; i++) {
+                d->quantSel[i] = p[8 + i * 3 + 2] & 3;
+            }
+        } else if (marker == 0xDB) {
+            for (q = p + 2; q < end; q += 64) {
+                id = *q++ & 3;
+                for (i = 0; i < 64; i++) {
