+/* General Codes, "CostumeBoundCheck": a costume the character does not have becomes 0, and a
+ * player on the same character, costume and shade as an earlier one gets the next shade. */
+static void mu_costume_bound_check(void)
+{
+    int i, j;
+    for (i = 0; i < 6; i++) {
+        if (Player_GetPlayerSlotType(i) == Gm_PKind_NA) {
+            continue;
+        }
+        if ((s32) Player_GetCostumeId(i) <
+            (s32) gm_GetNumCostumesForCKind(Player_GetPlayerCharacter(i)))
+        {
+            continue;
+        }
+        Player_SetCostumeId(i, 0);
+    }
+    for (i = 0; i < 6; i++) {
+        s32 ckind, costume, shade;
+        if (Player_GetPlayerSlotType(i) == Gm_PKind_NA) {
+            continue;
+        }
+        ckind = Player_GetPlayerCharacter(i);
+        costume = Player_GetCostumeId(i);
+        shade = Player_GetSubColor(i);
+        for (j = 0; j < 6; j++) {
+            s32 other;
+            if (j == i || Player_GetPlayerSlotType(j) == Gm_PKind_NA) {
+                continue;
+            }
+            if ((s32) Player_GetPlayerCharacter(j) != ckind ||
+                (s32) Player_GetCostumeId(j) != costume)
+            {
+                continue;
+            }
+            other = Player_GetSubColor(j);
+            if (other != shade) {
+                continue;
+            }
+            Player_SetSubColor(j, other + 1);
+        }
+    }
+}
