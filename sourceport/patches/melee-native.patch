+static void mu_thp_decode(MuTHPDecoder* d, u8* tileY, u8* tileU, u8* tileV,
+                          u32 width)
+{
+    THPCoeff blk[64];
+    u32 mcusPerRow = (d->xPixelSize + 15) / 16;
+    u32 rows = (d->ySize + 15) / 16;
+    u32 row;
+    u32 col;
+
+    if (mcusPerRow > width / 16) {
+        mcusPerRow = width / 16;
+    }
+    d->bitCnt = 0;
+    for (row = 0; row < rows; row++) {
+        for (col = 0; col < mcusPerRow; col++) {
+            mu_thp_block(d, blk, 0);
+            mu_thp_idct(blk, d->quant[d->quantSel[0]], tileY, width, col * 16, row * 16);
+            mu_thp_block(d, blk, 0);
+            mu_thp_idct(blk, d->quant[d->quantSel[0]], tileY, width, col * 16 + 8, row * 16);
+            mu_thp_block(d, blk, 0);
+            mu_thp_idct(blk, d->quant[d->quantSel[0]], tileY, width, col * 16, row * 16 + 8);
+            mu_thp_block(d, blk, 0);
+            mu_thp_idct(blk, d->quant[d->quantSel[0]], tileY, width, col * 16 + 8, row * 16 + 8);
+            mu_thp_block(d, blk, 1);
+            mu_thp_idct(blk, d->quant[d->quantSel[1]], tileU, width / 2, col * 8, row * 8);
+            mu_thp_block(d, blk, 2);
+            mu_thp_idct(blk, d->quant[d->quantSel[2]], tileV, width / 2, col * 8, row * 8);
+
+            if (d->RST != 0 && --d->currMCU == 0) {
+                d->currMCU = d->nMCU;
+                d->bitCnt = 0;
+                d->predDC[0] = d->predDC[1] = d->predDC[2] = 0;
+            }
+        }
+    }
+}
