+
+static void mu_neutral_spawn(int slot, u8 teams)
+{
+    u32 scene;
+    int index, s, team;
+    if (gm_IsCurrently1PMode_inline() || slot >= 5) {
+        return;
+    }
+    scene = ((u32) gm_GetCurrentSceneIndex() << 8) | gm_GetCurrentGameMode();
+    if (scene == 0x21C || scene == 0x10F) {
+        return;
+    }
+    if (teams != 1) {
+        index = 0;
+        for (s = 0; s <= 4; s++) {
+            if (Player_GetPlayerSlotType(s) == Gm_PKind_NA) {
+                continue;
+            }
+            if (s == slot) {
+                break;
+            }
+            index++;
+        }
+        mu_neutral_spawn_at(slot, index, teams);
+        return;
+    }
+    for (team = 0; team < 3; team++) {
+        int count = 0;
+        for (s = 0; s < 4; s++) {
+            if (Player_GetPlayerSlotType(s) != Gm_PKind_NA && Player_GetTeam(s) == team) {
+                count++;
+            }
+        }
+        if (count == 1 || count > 2) {
+            return;
+        }
+    }
+    {
+        int order[4] = { -1, -1, -1, -1 };
+        int n = 0;
+        for (team = 0; team < 3; team++) {
+            for (s = 0; s < 4; s++) {
+                if (Player_GetPlayerSlotType(s) != Gm_PKind_NA && Player_GetTeam(s) == team) {
+                    order[n++] = s;
+                }
+            }
+        }
+        for (index = 0; index < 4; index++) {
+            if (order[index] == slot) {
+                break;
+            }
+        }
+        mu_neutral_spawn_at(slot, index, 1);
+    }
+}
