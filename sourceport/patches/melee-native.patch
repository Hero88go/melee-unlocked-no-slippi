+    for (i = 0; i < 8; i++) {
+        f32 o[8];
+        w = ws + i * 8;
+        tmp10 = w[0] + w[4];
+        tmp11 = w[0] - w[4];
+        tmp13 = w[2] + w[6];
+        tmp12 = (w[2] - w[6]) * 1.414213562f - tmp13;
+        tmp0 = tmp10 + tmp13;
+        tmp3 = tmp10 - tmp13;
+        tmp1 = tmp11 + tmp12;
+        tmp2 = tmp11 - tmp12;
+        z13 = w[5] + w[3];
+        z10 = w[5] - w[3];
+        z11 = w[1] + w[7];
+        z12 = w[1] - w[7];
+        tmp7 = z11 + z13;
+        tmp11 = (z11 - z13) * 1.414213562f;
+        z5 = (z10 + z12) * 1.847759065f;
+        tmp10 = 1.082392200f * z12 - z5;
+        tmp12 = -2.613125930f * z10 + z5;
+        tmp6 = tmp12 - tmp7;
+        tmp5 = tmp11 - tmp6;
+        tmp4 = tmp10 + tmp5;
+        o[0] = tmp0 + tmp7;
+        o[7] = tmp0 - tmp7;
+        o[1] = tmp1 + tmp6;
+        o[6] = tmp1 - tmp6;
+        o[2] = tmp2 + tmp5;
+        o[5] = tmp2 - tmp5;
+        o[4] = tmp3 + tmp4;
+        o[3] = tmp3 - tmp4;
