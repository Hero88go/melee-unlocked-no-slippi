@@ -0,0 +1,212 @@
+#include "lbcardserial.h"
+
+#include <Runtime/platform.h>
+#include <string.h>
+
+_Static_assert(sizeof(GmSaveData) == 0x1790, "GmSaveData card size changed");
+_Static_assert(sizeof(struct NameTagDataBank) == 0x1F2C,
+               "NameTagDataBank card size changed");
+_Static_assert(sizeof(u16) == 2 && sizeof(u32) == 4 && sizeof(u64) == 8,
+               "card scalar widths changed");
+
+static void swap16(void* value)
+{
+    u8* bytes = value;
+    u8 tmp = bytes[0];
+    bytes[0] = bytes[1];
+    bytes[1] = tmp;
+}
+
+static void swap32(void* value)
+{
+    u8* bytes = value;
+    u8 tmp;
+    tmp = bytes[0]; bytes[0] = bytes[3]; bytes[3] = tmp;
+    tmp = bytes[1]; bytes[1] = bytes[2]; bytes[2] = tmp;
+}
+
+static void swap64(void* value)
+{
+    u8* bytes = value;
+    u8 tmp;
+    tmp = bytes[0]; bytes[0] = bytes[7]; bytes[7] = tmp;
+    tmp = bytes[1]; bytes[1] = bytes[6]; bytes[6] = tmp;
+    tmp = bytes[2]; bytes[2] = bytes[5]; bytes[5] = tmp;
+    tmp = bytes[3]; bytes[3] = bytes[4]; bytes[4] = tmp;
+}
+
+/* GCC's little-endian host assigns the first bitfield to the low bit. The
+ * console's big-endian compiler assigns it to the high bit of the 16-bit
+ * storage run. Reverse each byte's bit order without moving the run. */
+static void reverseBitfieldBytes(void* value)
+{
+    u8* bytes = value;
+    u8 first = bytes[0];
+    u8 second = bytes[1];
+    u8 reversed_first = 0;
+    u8 reversed_second = 0;
+    int i;
+    for (i = 0; i < 8; i++) {
+        reversed_first |= ((first >> i) & 1) << (7 - i);
+        reversed_second |= ((second >> i) & 1) << (7 - i);
+    }
+    bytes[0] = reversed_first;
+    bytes[1] = reversed_second;
+}
+
+static void swap16Array(void* values, size_t count)
+{
+    u8* bytes = values;
+    size_t i;
+    for (i = 0; i < count; i++) {
+        swap16(bytes + i * sizeof(u16));
+    }
+}
+
+static void swap32Array(void* values, size_t count)
+{
+    u8* bytes = values;
+    size_t i;
+    for (i = 0; i < count; i++) {
+        swap32(bytes + i * sizeof(u32));
+    }
+}
+
+static void swapStats(struct GmStats* stats)
+{
+    swap16(&stats->sd_count);
+    swap32(&stats->attacks_hit);
+    swap32(&stats->attacks_total);
+    swap32(&stats->damage_dealt);
+    swap32(&stats->damage_taken);
+    swap32(&stats->damage_recovered);
+    swap16(&stats->peak_damage);
+    swap16(&stats->match_count);
+    swap16(&stats->victories);
+    swap16(&stats->losses);
+    swap32(&stats->play_time);
+    swap32(&stats->total_player_count);
+    swap32(&stats->walk_distance);
+    swap32(&stats->run_distance);
+    swap32(&stats->fall_distance);
+    swap32(&stats->peak_height);
+    swap32(&stats->coins_collected);
+    swap32(&stats->coins_swiped);
+    swap32(&stats->coins_lost);
+}
+
+static void swapFighterData(struct FighterData* data)
+{
+    swap16Array(data->fighter_kos, SELKIND_COUNT);
+    swapStats(&data->stats);
+    reverseBitfieldBytes(&data->x7C);
+    swap16(&data->x7C.x7E);
+    swap32(&data->x7C.x84);
+    swap32(&data->x7C.x88);
+    swap32(&data->x7C.x8C);
+    swap32(&data->x7C.x90);
+    swap32(&data->x7C.x94);
+    swap32(&data->x7C.x98);
+    swap32(&data->x7C.x9C);
+    swap16(&data->x7C.xA0);
+    swap16(&data->x7C.xA2);
+    swap32(&data->x7C.xA4);
+    swap32(&data->x7C.xA8);
+}
+
+void lbCardGame_ConvertSaveDataByteOrder(GmSaveData* data)
+{
+    size_t i;
+    struct gmm_retval_ED98* ed98 = &data->unk_8;
+    struct gmm_retval_EDB0* edb0 = &data->unk_28;
+    struct gmm_retval_EDBC* edbc = &data->unk_30;
+
+    swap16(&data->unlocked_characters);
+    swap16(&data->x186A);
+    swap32(&ed98->x0);
+    swap32(&ed98->x4);
+    swap32(&ed98->xC);
+    swap32(&ed98->x10);
+    swap32(&ed98->x14);
+    swap32(&ed98->x18);
+    swap32(&ed98->x1C);
+    swap32(&edb0->x0);
+    swap32(&edb0->x4);
+    swap32(&edbc->x0);
+    swap32(&edbc->x4);
+    swap32(&edbc->x8);
+    swap32(&edbc->xC);
+    swap32(&edbc->x10);
+    swap32(&edbc->x14);
+    swap16Array(edbc->x18, SELKIND_COUNT);
+    swap32Array(edbc->x4C, 4);
+    swap32Array(edbc->xB0, SELKIND_COUNT);
+    swap32Array(edbc->x114, SELKIND_COUNT);
+    swap32(&data->unk_1A8.x0);
+    swap32(&data->time_matches);
+    swap32(&data->stock_matches);
+    swap32(&data->coin_matches);
+    swap32(&data->bonus_matches);
+    swap32(&data->stamina_matches);
+    swap32(&data->match_resets);
+    swap32(&data->x1A30);
+    swap32(&data->x1A34);
+    swap32(&data->x1A38);
+    swap32(&data->x1A3C);
+    swap32(&data->x1A40);
+    swap32(&data->x1A44);
+    swap32(&data->x1A48);
+    swap32(&data->x1A4C);
+    swap32(&data->x1A50);
+    swap32(&data->x1A54);
+    swap32(&data->x1A58);
+    swap32(&data->x1A5C);
+    swap32(&data->x1A60);
+    swap32(&data->x1A64);
+    swap64(&data->x1A68);
+    swap32Array(data->x1A70, 4);
+    swap32Array(data->x1B40, 3);
+    swap32Array(data->x1B4C, 3);
+    swap32Array(data->x1B58,
+                ARRAY_SIZE(data->x1B58));
+    swap32Array(data->x1B80, ARRAY_SIZE(data->x1B80));
+    swap32Array(data->x1C88, ARRAY_SIZE(data->x1C88));
+    swap64(&data->x1CB0.item_mask);
+    swap32(&data->x1CB0.stage_mask);
+    swap16(&data->trophy_count);
+    swap16(&data->trophy_category_flags);
+    swap16Array(data->trophy_flags, TY_TROPHY_COUNT);
+    for (i = 0; i < SELKIND_COUNT; i++) {
+        swapFighterData(&data->x1F2C[i]);
+    }
+}
+
+void lbCardGame_ConvertNameTagByteOrder(struct NameTagDataBank* bank)
+{
+    size_t i;
+    for (i = 0; i < GM_NAMETAG_BANK_SIZE; i++) {
+        struct NameTagData* tag = &bank->inner[i];
+        swap16Array(tag->vs_kos, GM_NAMETAG_COUNT);
+        swapStats(&tag->stats);
+        swap32Array(tag->play_time_by_fighter, SELKIND_COUNT);
+    }
+}
+
+void lbCardGame_CommitReadEntries(struct GmCardData* live,
+                                  GmSaveData* save_staging,
+                                  struct NameTagDataBank* banks_staging,
+                                  const s32* entry_status)
+{
+    size_t i;
+    if (entry_status[1] == 0) {
+        lbCardGame_ConvertSaveDataByteOrder(save_staging);
+        memcpy(&live->save_data, save_staging, sizeof(live->save_data));
+    }
+    for (i = 0; i < GM_NAMETAG_BANK_COUNT; i++) {
+        if (entry_status[2 + i] == 0) {
+            lbCardGame_ConvertNameTagByteOrder(&banks_staging[i]);
+            memcpy(&live->nametag_banks[i], &banks_staging[i],
+                   sizeof(live->nametag_banks[i]));
+        }
+    }
+}
