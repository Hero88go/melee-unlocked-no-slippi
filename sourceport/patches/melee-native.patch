+#ifdef MU_NATIVE
+/* General Codes, "Winners Names are Gold on CSS": whether this port won the match the VS exit
+ * recorded. After an L+R+A+Start ending (outcome 7) everyone but the side that ended it counts. */
+static bool mu_css_last_winner(int port)
+{
+    MatchEnd* me = &gmVsMelee_VsExitInfo.match_end;
+    struct MatchPlayerData* p = &me->player_standings[port];
+    if (me->outcome == 0) {
+        return false;
+    }
+    if (gmVs_GetSceneController()->start.is_teams != me->is_teams) {
+        return false;
+    }
+    if (p->pkind == 3) {
+        return false;
+    }
+    if (me->outcome == 7) {
+        /* The ender's slot, kept in the top byte by gm_Scene_Vs_OnExit. */
+        u8 ender = (u8) (me->x0 >> 24);
+        if (ender >= GM_MAX_PLAYERS) {
+            return true;
+        }
+        if (me->is_teams == 1) {
+            return me->player_standings[ender].team != p->team;
+        }
+        return ender != port;
+    }
+    if (me->is_teams == 1) {
+        return fn_801654A0(me) == p->team;
+    }
+    return p->is_big_loser == 0;
+}
+#endif
