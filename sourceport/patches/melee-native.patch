-void MIXUpdateSettings(void) {
-    int i;
-    int setNewMixLevel;
-    int setNewInputLevel;
-    struct MIXChannel * c;
-    AXVPB * axvpb;
-    u16 mixerCtrl;
-    u16 * p;
-
-    for(i = 0; i < 64; i++) {
-        setNewInputLevel = 0;
-        setNewMixLevel = 0;
-        c = &__MIXChannel[i];
-        axvpb = c->axvpb;
-        if (axvpb) {
-            if (c->mode & 0x20000000) {
-                c->v = c->v1;
-                c->mode &= 0xDFFFFFFF;
-                setNewInputLevel = 1;
-            }
-            if (c->mode & 0x10000000) {
-                if (c->mode & 4) {
-                    c->v1 = 0U;
-                } else {
-                    c->v1 = __MIXGetVolume(c->input);
-                }
-                c->mode |= 0x20000000;
-                setNewInputLevel = 1;
-            }
-            if (c->mode & 0x80000000) {
-                c->vL = c->vL1;
-                c->vR = c->vR1;
-                c->vS = c->vS1;
-                c->vAL = c->vAL1;
-                c->vAR = c->vAR1;
-                c->vAS = c->vAS1;
-                c->vBL = c->vBL1;
-                c->vBR = c->vBR1;
-                c->vBS = c->vBS1;
-                c->mode &= 0x7FFFFFFF;
-                setNewMixLevel = 1;
