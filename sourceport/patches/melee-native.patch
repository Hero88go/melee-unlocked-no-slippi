+/* Index of the chain root..leaf, adding it (and any joint not yet recorded) on first use. */
+static u32 PObjNativeEnvChain(HSD_JObj* leaf, MuNativePoseU32* chain_index)
+{
+    HSD_JObj* jobj;
+    u32 depth = 0, i, j;
+
+    for (i = 0; i < native_env_chain_count; ++i) {
+        if (native_env_chain_leaves[i] == leaf) {
+            *chain_index = i;
+            return MU_NATIVE_POSE_REJECT_NONE;
+        }
+    }
+    if (native_env_chain_count >= MU_NATIVE_POSE_MAX_CHAINS)
+        return MU_NATIVE_POSE_REJECT_ENVELOPE_LIMIT;
+    for (jobj = leaf; jobj != NULL && depth < MU_NATIVE_POSE_MAX_JOINTS; jobj = jobj->parent)
+        native_pose_chain[depth++] = jobj;
+    if (jobj != NULL)
+        return MU_NATIVE_POSE_REJECT_CHAIN_LIMIT;
+    if (depth > MU_NATIVE_POSE_MAX_LINKS - native_env_link_count)
+        return MU_NATIVE_POSE_REJECT_ENVELOPE_LIMIT;
+
+    native_env_chains[native_env_chain_count].first_link = native_env_link_count;
+    native_env_chains[native_env_chain_count].link_count = depth;
+    for (i = 0; i < depth; ++i) {
+        HSD_JObj* source = native_pose_chain[depth - i - 1];
+        for (j = 0; j < native_env_joint_count; ++j)
+            if (native_env_joint_objs[j] == source)
+                break;
+        if (j == native_env_joint_count) {
+            u32 reject;
+            if (native_env_joint_count >= MU_NATIVE_POSE_MAX_TOTAL_JOINTS)
+                return MU_NATIVE_POSE_REJECT_ENVELOPE_LIMIT;
+            reject = PObjNativeFillJoint(source, &native_pose_joints[j], PObjNativeIdentity(source),
+                                         &native_env_track_count,
+                                         &native_env_track_byte_count);
+            if (reject != MU_NATIVE_POSE_REJECT_NONE)
+                return reject;
+            native_env_joint_objs[j] = source;
+            ++native_env_joint_count;
+        }
+        native_env_links[native_env_link_count++] = j;
+    }
+    native_env_chain_leaves[native_env_chain_count] = leaf;
+    *chain_index = native_env_chain_count++;
+    return MU_NATIVE_POSE_REJECT_NONE;
+}
+
+/* Skinned PObj, emitted after setup_mtx so every bone matrix is the one this draw loads.
+ * Mirrors SetupEnvelopeModelMtx and _HSD_mkEnvelopeModelNodeMtx: view, skeleton "right"
+ * transform, and per matrix slot the weighted bones with their inverse-bind matrices. */
+static void PObjEmitNativeEnvelopeSnapshot(HSD_PObj* pobj, Mtx vmtx, u32 scope_id,
+                                           u32 default_setup)
+{
+    MuNativePoseSnapshot snapshot;
+    HSD_JObj* m;
+    HSD_SList* list;
+    u32 slot, bone_count = 0, reject = MU_NATIVE_POSE_REJECT_NONE;
+
+    __builtin_memset(&snapshot, 0, sizeof(snapshot));
+    snapshot.scope_id = scope_id;
+    snapshot.kind = MU_NATIVE_POSE_ENVELOPE;
+    snapshot.default_setup = default_setup;
+    native_env_joint_count = native_env_chain_count = native_env_link_count = 0;
+    native_env_track_count = native_env_track_byte_count = 0;
+
+    m = HSD_JObjGetCurrent();
+    if (m == NULL) {
+        reject = MU_NATIVE_POSE_REJECT_NO_JOINT;
+        goto done;
+    }
+    if (!(m->flags & JOBJ_SKELETON_ROOT)) {
+        HSD_JObj* x = HSD_JObjFindSkeleton(m);
+        if (x == NULL) {
+            reject = MU_NATIVE_POSE_REJECT_ENVELOPE_DATA;
+            goto done;
+        }
+        reject = PObjNativeEnvChain(m, &snapshot.right_chain_m);
+        if (reject == MU_NATIVE_POSE_REJECT_NONE)
+            reject = PObjNativeEnvChain(x, &snapshot.right_chain_x);
+        if (reject != MU_NATIVE_POSE_REJECT_NONE)
+            goto done;
+        if (x == m || !(x->flags & JOBJ_SKELETON_ROOT)) {
+            if (x->envelopemtx == NULL) {
+                reject = MU_NATIVE_POSE_REJECT_ENVELOPE_DATA;
+                goto done;
+            }
+            __builtin_memcpy(snapshot.right_envelope, x->envelopemtx,
+                             sizeof(snapshot.right_envelope));
+            snapshot.right_kind = x == m ? 1 : 3;
+        } else {
+            snapshot.right_kind = 2;
+        }
+    }
+
+    for (slot = 0, list = pobj->u.envelope_list; slot < MU_NATIVE_POSE_MAX_SLOTS && list;
+         ++slot, list = list->next)
+    {
+        HSD_Envelope* env = list->data;
+        BOOL single;
+        if (env == NULL) {
+            reject = MU_NATIVE_POSE_REJECT_ENVELOPE_DATA;
+            goto done;
+        }
+        single = env->weight >= (1.0f - FLT_EPSILON);
+        native_env_slots[slot].first_bone = bone_count;
+        native_env_slots[slot].bone_count = 0;
+        for (; env != NULL; env = single ? NULL : env->next) {
+            MuNativePoseBone* bone;
+            if (bone_count >= MU_NATIVE_POSE_MAX_BONES ||
+                native_env_slots[slot].bone_count >= 64) {
+                reject = MU_NATIVE_POSE_REJECT_ENVELOPE_LIMIT;
+                goto done;
+            }
+            if (env->jobj == NULL || env->jobj->envelopemtx == NULL) {
+                reject = MU_NATIVE_POSE_REJECT_ENVELOPE_DATA;
+                goto done;
+            }
+            bone = &native_env_bones[bone_count];
+            reject = PObjNativeEnvChain(env->jobj, &bone->chain);
+            if (reject != MU_NATIVE_POSE_REJECT_NONE)
+                goto done;
+            bone->weight = single ? 1.0f : env->weight;
+            __builtin_memcpy(bone->envelope, env->jobj->envelopemtx, sizeof(bone->envelope));
+            ++bone_count;
+            ++native_env_slots[slot].bone_count;
+        }
+    }
+    if (slot == 0) {
+        reject = MU_NATIVE_POSE_REJECT_ENVELOPE_DATA;
+        goto done;
+    }
+
+    snapshot.joint_count = native_env_joint_count;
+    snapshot.track_count = native_env_track_count;
+    snapshot.track_byte_count = native_env_track_byte_count;
+    snapshot.chain_count = native_env_chain_count;
+    snapshot.link_count = native_env_link_count;
+    snapshot.bone_count = bone_count;
+    snapshot.slot_count = slot;
+    snapshot.has_view = vmtx != NULL;
+    snapshot.quake = snapshot.has_view && mu_camera_quaking();
+    if (snapshot.has_view)
+        __builtin_memcpy(snapshot.view, vmtx, sizeof(snapshot.view));
+    snapshot.joints = native_pose_joints;
+    snapshot.tracks = native_env_track_count != 0 ? native_pose_tracks : NULL;
+    snapshot.track_bytes = native_env_track_byte_count != 0 ? native_pose_track_bytes : NULL;
+    snapshot.chains = native_env_chains;
+    snapshot.links = native_env_links;
+    snapshot.bones = native_env_bones;
+    snapshot.slots = native_env_slots;
+done:
+    snapshot.reject_reason = reject;
+    mu_native_pose_snapshot(&snapshot);
+}
+
+static void PObjEmitNativePoseSnapshot(HSD_PObj* pobj, Mtx vmtx, u32 scope_id,
+                                       u32 default_setup)
+{
+    MuNativePoseSnapshot snapshot;
+    u32 depth = 0, track_count = 0, track_byte_count = 0;
+    HSD_JObj* jobj;
+    u32 i;
+
+    __builtin_memset(&snapshot, 0, sizeof(snapshot));
+    snapshot.scope_id = scope_id;
+    snapshot.default_setup = default_setup;
+    snapshot.kind = MU_NATIVE_POSE_UNSUPPORTED;
+    snapshot.reject_reason = MU_NATIVE_POSE_REJECT_KIND;
+
+    /* Rigid SKIN PObjs only here; envelope PObjs are emitted after setup_mtx by
+     * PObjEmitNativeEnvelopeSnapshot. Shared-vertex and shape animation paths remain
+     * exact-current-frame until their distinct pose sources have been audited. */
+    if (pobj_type(pobj) != POBJ_SKIN || pobj->u.jobj != NULL) {
+        mu_native_pose_snapshot(&snapshot);
+        return;
+    }
+
+    jobj = HSD_JObjGetCurrent();
+    if (jobj == NULL) {
+        snapshot.reject_reason = MU_NATIVE_POSE_REJECT_NO_JOINT;
+        mu_native_pose_snapshot(&snapshot);
+        return;
+    }
+    for (; jobj != NULL && depth < MU_NATIVE_POSE_MAX_JOINTS;
+         jobj = jobj->parent) {
+        native_pose_chain[depth++] = jobj;
+    }
+    if (jobj != NULL) {
+        snapshot.reject_reason = MU_NATIVE_POSE_REJECT_CHAIN_LIMIT;
+        mu_native_pose_snapshot(&snapshot);
+        return;
+    }
+
+    for (i = 0; i < depth; ++i) {
+        HSD_JObj* source = native_pose_chain[depth - i - 1];
+        u32 reject;
+
+        if (i == 0)
+            PObjReportNativeRootMatrix(source);
+        reject = PObjNativeFillJoint(source, &native_pose_joints[i], PObjNativeIdentity(source),
+                                     &track_count, &track_byte_count);
+        if (reject != MU_NATIVE_POSE_REJECT_NONE) {
+            snapshot.reject_reason = reject;
+            mu_native_pose_snapshot(&snapshot);
+            return;
+        }
+    }
+
+    snapshot.kind = MU_NATIVE_POSE_RIGID;
+    snapshot.reject_reason = MU_NATIVE_POSE_REJECT_NONE;
+    snapshot.joint_count = depth;
+    snapshot.track_count = track_count;
+    snapshot.track_byte_count = track_byte_count;
+    snapshot.has_view = vmtx != NULL;
+    snapshot.quake = snapshot.has_view && mu_camera_quaking();
+    if (snapshot.has_view)
+        __builtin_memcpy(snapshot.view, vmtx, sizeof(snapshot.view));
+    snapshot.joints = native_pose_joints;
+    snapshot.tracks = track_count != 0 ? native_pose_tracks : NULL;
+    snapshot.track_bytes = track_byte_count != 0 ? native_pose_track_bytes : NULL;
+    mu_native_pose_snapshot(&snapshot);
+}
