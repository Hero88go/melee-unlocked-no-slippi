+/* Skins (shim/mu_content.c): L / R on a highlighted costume step that costume through its installed
+ * skins. While 20XX TE's shield colors are on, L / R are theirs and skins do not cycle. The pick's
+ * name shows for a moment where the shield label would be (the two are never on together). */
+int mu_skin_cycle(int port, int char_kind, int costume, int next, char* name, int capacity);
+static HSD_Text* mu_skin_text[4];
+static int mu_skin_text_frames[4];
+/* Where a door's KO counter is, kept when the screen is built. The label itself is only made at the
+ * first pick, so a screen where no skin is cycled allocates nothing it did not before. */
+static Point3d mu_skin_pos[4];
+static int mu_skin_pos_set[4];
+#define MU_SKIN_LABEL_FRAMES 120
+
+static void mu_skin_css_reset(void)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        mu_skin_text[i] = NULL;
+        mu_skin_text_frames[i] = 0;
+        mu_skin_pos_set[i] = 0;
+    }
+}
+
+/* Once a frame on the character select screen: the name goes away again. */
+static void mu_skin_css_frame(void)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        if (mu_skin_text_frames[i] > 0 && --mu_skin_text_frames[i] == 0 && mu_skin_text[i] != NULL) {
+            HSD_SisLib_803A70A0(mu_skin_text[i], 0, " ");
+        }
+    }
+}
+
+static void mu_css_skin_cycle(int door, int next)
+{
+    char name[64];
+    char label[32];
+    int i;
+    const int sel = mnCharSel_803F0DFC.doors[door].sel_icon;
+    /* The retail roster only: an m-ex select screen numbers its fighters and costumes its own way. */
+    if (mex_select != NULL || mu_te2(MU_TE2_SHIELD_COLORS)) {
+        return;
+    }
+    if (!mu_skin_cycle(door, icons[sel].char_kind, mnCharSel_803F0DFC.doors[door].costume, next, name,
+                       sizeof name))
+    {
+        return;
+    }
+    /* The costume's file now has another entry number. Have the preload ask for the fighters again
+     * (the game's own way of saying the scene changed), so the copy loaded under the old number is
+     * dropped and the match loads the picked skin. */
+    lbDvd_8001823C();
+    mnCharSel_8025DB34((u8) door);
+    sfxMove();
+    if (door < 0 || door >= 4 || !mu_skin_pos_set[door]) {
+        return;
+    }
+    if (mu_skin_text[door] == NULL) {
+        /* free text (like the shield label), one line under the door's KO counter */
+        HSD_Text* text = HSD_SisLib_803A6754(0, 0);
+        int line;
+        text->default_kerning = 1;
+        text->default_alignment = 1;
+        text->font_size.x = 0.1f;
+        text->font_size.y = 0.1f;
+        line = HSD_SisLib_803A6B98(text, MU_TE_SHIELD_X(mu_skin_pos[door].x), MU_TE_SHIELD_Y(mu_skin_pos[door].y),
+                                   " ");
+        HSD_SisLib_803A7548(text, line, 0.4f, 0.4f);
+        mu_skin_text[door] = text;
+    }
+    /* The label font has the plain letters and digits; anything else becomes a space. */
+    for (i = 0; i < (int) sizeof label - 1 && name[i] != '\0'; i++) {
+        const char c = name[i];
+        label[i] = ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.')
+                       ? c
+                       : ' ';
+    }
+    label[i] = '\0';
+    HSD_SisLib_803A70A0(mu_skin_text[door], 0, "%s", i > 0 ? label : " ");
+    mu_skin_text_frames[door] = MU_SKIN_LABEL_FRAMES;
+}
