+static void PObjReportNativeRootMatrix(HSD_JObj* jobj)
+{
+    Mtx local, expected;
+    Vec3* parent_scale;
+    u32 row, col;
+    int mismatch = 0;
+
+    if (native_pose_provenance_reported || !mu_native_render_scope_enabled())
+        return;
+    /* This is the exact static root from the first Source s8 record. Keep the extra report
+     * limited to that fixture; ordinary source runs never enable the PObj audit callback. */
+    if ((jobj->flags & 0x20000008u) != 0x20000008u ||
+        fabsf(jobj->scale.x - 1.0f) > 0.00001f ||
+        fabsf(jobj->scale.y - 0.7f) > 0.00001f ||
+        fabsf(jobj->scale.z - 1.0f) > 0.00001f ||
+        fabsf(jobj->rotate.x) > 0.00001f || fabsf(jobj->rotate.y) > 0.00001f ||
+        fabsf(jobj->rotate.z - 0.349065989f) > 0.00001f ||
+        fabsf(jobj->translate.x - 19.0f) > 0.00001f ||
+        fabsf(jobj->translate.y - 14.9919701f) > 0.0001f ||
+        fabsf(jobj->translate.z) > 0.00001f)
+        return;
+
+    parent_scale = jobj->parent != NULL ? jobj->parent->scl : NULL;
+    HSD_MtxSRT(local, &jobj->scale, (Vec3*) &jobj->rotate, &jobj->translate, parent_scale);
+    if (jobj->parent != NULL)
+        PSMTXConcat(jobj->parent->mtx, local, expected);
+    else
+        __builtin_memcpy(expected, local, sizeof(expected));
+
+    for (row = 0; row < 3; ++row) {
+        for (col = 0; col < 4; ++col) {
+            const f32 actual = jobj->mtx[row][col];
+            const f32 calculated = expected[row][col];
+            if (!__builtin_isfinite(actual) || !__builtin_isfinite(calculated) ||
+                fabsf(actual - calculated) > 0.002f * (1.0f + fabsf(actual)))
+                mismatch = 1;
+        }
+    }
+    native_pose_provenance_reported = 1;
+    OSReport("[M8-HSD-MATRIX] mismatch=%d flags=%08X class_info=%p make_mtx=%p standard_mtx=%u parent=%p parent_flags=%08X parent_scl=%p aobj=%p aobj_hsd=%p S=(%.9g,%.9g,%.9g) R=(%.9g,%.9g,%.9g) T=(%.9g,%.9g,%.9g)",
+             mismatch,
+             jobj->flags,
+             (void*) jobj->object.parent.class_info,
+             (void*) HSD_JOBJ_METHOD(jobj)->make_mtx,
+             HSD_JOBJ_METHOD(jobj)->make_mtx == HSD_JObjMakeMatrix,
+             (void*) jobj->parent,
+             jobj->parent != NULL ? jobj->parent->flags : 0,
+             jobj->parent != NULL ? (void*) jobj->parent->scl : NULL,
+             (void*) jobj->aobj,
+             jobj->aobj != NULL ? (void*) jobj->aobj->hsd_obj : NULL,
+             jobj->scale.x, jobj->scale.y, jobj->scale.z,
+             jobj->rotate.x, jobj->rotate.y, jobj->rotate.z,
+             jobj->translate.x, jobj->translate.y, jobj->translate.z);
+    for (row = 0; row < 3; ++row)
+        OSReport("[M8-HSD-MATRIX] row%u hsd_srt_parent=(%.9g,%.9g,%.9g,%.9g) captured=(%.9g,%.9g,%.9g,%.9g)",
+                 row,
+                 expected[row][0], expected[row][1], expected[row][2], expected[row][3],
+                 jobj->mtx[row][0], jobj->mtx[row][1], jobj->mtx[row][2], jobj->mtx[row][3]);
+}
