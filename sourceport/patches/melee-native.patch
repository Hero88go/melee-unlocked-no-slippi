+static void mu_neutral_spawn_at(int slot, int index, u8 teams)
+{
+    static const u8 team_order[4] = { 0, 3, 1, 2 };
+    /* Training Mode CE carries its own copy of the code (ASM/Additional Codes/Neutral Spawn.asm),
+     * the same table except Final Destination's teams row. Its events are team matches with both
+     * fighters on one team, so that row decides which side the CPU starts on, and events such as
+     * the down-throw knee one restart until the player stands on the side they expect. */
+    static const float tmce_fd_teams[4][2] = { { -20, 10 }, { -60, 10 }, { 20, 10 }, { 60, 10 } };
+    Vec3 pos;
+    int e;
+    for (e = 0; e < (int) ARRAY_SIZE(mu_neutral_spawns); e++) {
+        if (mu_neutral_spawns[e].stkind == (s32) Stage_80225194()) {
+            break;
+        }
+    }
+    if (e < (int) ARRAY_SIZE(mu_neutral_spawns)) {
+        const float* p = teams ? mu_neutral_spawns[e].teams[index & 3]
+                               : mu_neutral_spawns[e].singles[index & 3];
+        if (teams && mu_neutral_spawns[e].stkind == 0x20 && mu_tmce_active()) {
+            p = tmce_fd_teams[index & 3];
+        }
+        pos.x = p[0];
+        pos.y = p[1];
+        pos.z = 0.0f;
+        Player_80032768(slot, &pos);
+    } else {
+        Stage_80224E64(teams == 1 ? team_order[index & 3] : index, &pos);
+        Player_80032768(slot, &pos);
