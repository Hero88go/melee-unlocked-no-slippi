+    OSSetCurrentContext(&thread->context);
+    thread->stackBase = (unsigned char*) &_stack_addr;
+    thread->stackEnd = (unsigned long*) &_stack_end;
+    *(u32*) thread->stackEnd = 0xDEADBABE;
+    __gCurrentThread = thread;
+    RunQueueBits = 0;
+    RunQueueHint = 0;
