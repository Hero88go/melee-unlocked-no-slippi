+    struct OSThread* thread = &DefaultThread;
+    int prio;
+
+    thread->state = 2;
+    thread->attr = 1;
+    thread->priority = thread->base = 0x10;
+    thread->suspend = 0;
+    thread->val = (void*) -1; // wut
+    thread->mutex = 0;
