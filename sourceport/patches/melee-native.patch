+/* The identity of a joint or PObj for the host's sampler and draw pairing: the object itself, the
+ * way the translated capture keys joints by the object it saw allocated. The index in the chain
+ * used to stand in for a joint's, so
+ * every chain of the same depth shared identities: when a menu dropped draws and the host paired
+ * a panel with another object's draw, it sampled that object's animation clock and the panels
+ * replayed their fly-in between two frames. */
+static u32 PObjNativeIdentity(const void* object)
+{
+    __UINTPTR_TYPE__ address = (__UINTPTR_TYPE__) object;
+    return (u32) (address ^ (address >> 32));
+}
+
+/* Copies one joint (local SRT, world matrix, authored tracks) into a POD record. Returns a
+ * MU_NATIVE_POSE_REJECT_* reason, NONE when the joint is inside the supported feature boundary. */
+static u32 PObjNativeFillJoint(HSD_JObj* source, MuNativePoseJoint* target, u32 generation,
+                               u32* track_count, u32* track_byte_count)
+{
+    HSD_FObj* fobj;
+    u32 flags = source->flags & ~0x40u;
+
+    /* Match the already measured translated capture's supported feature boundary. */
+    if (flags & (0x2E00u | 0x1000u | 0x600000u | 0x3800000u))
+        return MU_NATIVE_POSE_REJECT_JOINT_FLAGS;
+    if (source->robj != NULL)
+        return MU_NATIVE_POSE_REJECT_CONSTRAINTS;
+
+    __builtin_memset(target, 0, sizeof(*target));
+    target->generation = generation;
+    target->flags = flags;
+    target->scale[0] = source->scale.x;
+    target->scale[1] = source->scale.y;
+    target->scale[2] = source->scale.z;
+    target->rotation[0] = source->rotate.x;
+    target->rotation[1] = source->rotate.y;
+    target->rotation[2] = source->rotate.z;
+    target->quaternion[0] = source->rotate.x;
+    target->quaternion[1] = source->rotate.y;
+    target->quaternion[2] = source->rotate.z;
+    target->quaternion[3] = source->rotate.w;
+    target->translation[0] = source->translate.x;
+    target->translation[1] = source->translate.y;
+    target->translation[2] = source->translate.z;
+    __builtin_memcpy(target->world, source->mtx, sizeof(target->world));
+    target->first_track = *track_count;
+
+    if (source->aobj == NULL)
+        return MU_NATIVE_POSE_REJECT_NONE;
+    /* The translated capture (render_observer.cpp) refuses an animation bound to another object
+     * and reports no rate while the animation is stopped (AOBJ_NO_ANIM or AOBJ_NO_UPDATE): the
+     * sampler must hold those joints, not play them. Menu panels loop an animation of this kind,
+     * and playing it between frames drew the panels' fly-in pose once per loop. */
+    if (source->aobj->hsd_obj != NULL)
+        return MU_NATIVE_POSE_REJECT_BOUND_ANIMATION;
+    target->anim_flags = source->aobj->flags;
+    target->frame = source->aobj->curr_frame;
+    target->rewind = source->aobj->rewind_frame;
+    target->end = source->aobj->end_frame;
+    if (source->aobj->flags & 0x50000000u)
+        return MU_NATIVE_POSE_REJECT_NONE;
+    target->rate = source->aobj->framerate;
+    for (fobj = source->aobj->fobj; fobj != NULL; fobj = fobj->next) {
+        MuNativePoseTrack* track;
+        if (target->track_count >= 32 || *track_count >= MU_NATIVE_POSE_MAX_TRACKS)
+            return MU_NATIVE_POSE_REJECT_TRACK_LIMIT;
+        if (fobj->length > 65535u ||
+            fobj->length > MU_NATIVE_POSE_MAX_TRACK_BYTES - *track_byte_count ||
+            (fobj->length != 0 && fobj->ad_head == NULL))
+            return MU_NATIVE_POSE_REJECT_TRACK_BYTES;
+        if (!((fobj->obj_type >= 1 && fobj->obj_type <= 3) ||
+              (fobj->obj_type >= 5 && fobj->obj_type <= 10)))
+            return MU_NATIVE_POSE_REJECT_TRACK_FORMAT;
+        track = &native_pose_tracks[(*track_count)++];
+        track->start_frame = fobj->startframe;
+        track->channel = fobj->obj_type;
+        track->value_format = fobj->frac_value;
+        track->slope_format = fobj->frac_slope;
+        track->byte_offset = *track_byte_count;
+        track->byte_length = fobj->length;
+        if (fobj->length != 0) {
+            __builtin_memcpy(native_pose_track_bytes + *track_byte_count,
+                             fobj->ad_head, fobj->length);
+            *track_byte_count += fobj->length;
+        }
+        ++target->track_count;
+    }
+    return MU_NATIVE_POSE_REJECT_NONE;
+}
