-        fontEncode = (__VIRegs[VI_DTV_STAT] & 2) ? OS_FONT_ENCODE_SJIS : OS_FONT_ENCODE_ANSI;
-        break;
-
-    case VI_PAL:
-    case VI_MPAL:
-    case VI_DEBUG:
