<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The game takes its command line and every file name as UTF-8. Without this the process uses
     the system's own code page, and a folder with letters outside it (an accented or non-Latin
     user name, for example) reached the game as bytes that are not UTF-8 and stopped it at start. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
