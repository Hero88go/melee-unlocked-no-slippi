// Launcher resources. The launcher has its own icon (Bailey) rather than the game's MU mark, so the
// two are easy to tell apart in the taskbar when both are open.
#define IDI_LAUNCHER   1
#define IDB_LAUNCHER_BG 2
#define IDI_MELEE_MARK 3
IDI_LAUNCHER    ICON   "launcher.ico"
IDB_LAUNCHER_BG BITMAP "launcher_bg.bmp"
// The game's MU mark, drawn over the background so the launcher is branded by the logo itself
// rather than by a line of text.
IDI_MELEE_MARK  ICON   "melee_unlocked.ico"
// Both of these are 32bpp with a premultiplied alpha channel, cut off the flat plate each was
// composited on (the mark off navy, Bailey off white) before the build, so the launcher just
// blends them onto the rail. The mark is kept at full resolution: the .ico tops out at 256 and
// drawing it at 84 is what made it look pixelated.
#define IDB_MELEE_MARK 4
#define IDB_BAILEY 5
IDB_MELEE_MARK  BITMAP "melee_mark.bmp"
IDB_BAILEY      BITMAP "bailey_cut.bmp"

// Version resource; see the same block in melee_unlocked.rc for why. The launcher needs it more
// than the game does: it is the file that downloads and replaces executables over the network,
// which is the behaviour heuristics react to, and it is the one players have reported missing
// after a download.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION     MELEE_VERSION_COMMAS
PRODUCTVERSION  MELEE_VERSION_COMMAS
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"   // US English, Unicode
    BEGIN
      VALUE "CompanyName",      "Melee Unlocked"
      VALUE "FileDescription",  "Melee Unlocked Launcher"
      VALUE "FileVersion",      MELEE_PORT_VERSION
      VALUE "InternalName",     "MeleeUnlockedLauncher"
      VALUE "OriginalFilename", "MeleeUnlockedLauncher.exe"
      VALUE "ProductName",      "Melee Unlocked"
      VALUE "ProductVersion",   MELEE_PORT_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

